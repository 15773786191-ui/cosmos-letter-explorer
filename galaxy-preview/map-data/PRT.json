31.1316,39.6588],[-31.1527,39.7011],[-31.1173,39.7283]]]]},"knowledge":{"theme":"亚速尔群岛 · 地形、历史与地方特色","geo":"14世纪时，亚速尔群岛就已经出现在加泰隆尼亚地图集上了，但是首先发现者已不可考证。\n通常认为，1427年，为恩里克供职的航海者贡萨洛·维利乌·卡布拉尔重新发现了亚速尔群岛。\n通常认为亚速尔群岛的名字来源于苍鹰，据说在发现亚速尔群岛时这种鸟类在岛上很常见。","culture":"虽然社会党在自治区中占主导地位，但社会民主党传统上在市镇议会选举中更受欢迎。\n跟农业和捕鲸业相关的传统也在几个世纪以来影响着群岛的文化。","see":null,"scope":"reference","qid":"Q25263","articleTitle":"亚速尔群岛","sourceRevision":93945342,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 亚速尔群岛","https://zh.wikipedia.org/wiki/%E4%BA%9A%E9%80%9F%E5%B0%94%E7%BE%A4%E5%B2%9B"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=93945342"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q25263"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"PT-18","name":"维塞乌区","english":"Viseu","country":"PRT","lat":40.8417,"lon":-7.82745,"kind":"region","bbox":[-8.3502,40.3206,-7.3007,41.2157],"geometry":{"type":"Polygon","coordinates":[[[-7.5968,41.1778],[-7.4174,41.2157],[-7.3597,41.1661],[-7.3007,41.1593],[-7.3335,41.0198],[-7.3735,41.0096],[-7.3341,40.9734],[-7.3415,40.9378],[-7.4234,40.9173],[-7.4125,40.8706],[-7.4455,40.8195],[-7.5579,40.8716],[-7.6186,40.7954],[-7.5399,40.6854],[-7.5777,40.5723],[-7.8452,40.4937],[-8.1162,40.3389],[-8.2354,40.3206],[-8.3502,40.372],[-8.3313,40.4844],[-8.2532,40.5145],[-8.302,40.5939],[-8.2486,40.619],[-8.2883,40.6376],[-8.325,40.7272],[-8.2396,40.8189],[-8.2496,40.8554],[-8.1154,40.8535],[-8.1289,40.936],[-8.0872,40.9999],[-8.1493,40.982],[-8.2244,41.0094],[-8.2296,41.0538],[-8.2902,41.0834],[-8.0621,41.1059],[-7.8433,41.1844],[-7.7379,41.1526],[-7.5968,41.1778]]]}}],"cities":[{"id":"city-1159151273","name":"里斯本","country":"PRT","lat":38.72467,"lon":-9.14681,"kind":"city","region":"PT-11","rank":2,"capital":1,"knowledge":{"theme":"里斯本 · 地形、历史与地方特色","geo":"其位置位于葡萄牙中南部大西洋沿岸，城北为辛特拉山，城南为特茹河出海口，与伦敦、巴黎、罗马等同为西欧历史最悠久的城市。\n葡萄牙语国家共同体（CPLP）总部设在该市，是欧洲大陆最西端的首都，位于大西洋沿岸。\n里斯本因其在金融、商业、媒体、娱乐、艺术、国际贸易、教育和旅游方面的重要性，依照全球化及世界城市研究网络（GaWC）所公布之《世界级城市》名单中，被列为属于ALPHA-级别的国际都市 ，也是欧洲大陆的主要经济中心之一，里斯本港也是欧洲大西洋沿岸最大的货柜港之一。","culture":"建于二战后，以纪念葡萄牙免于战争的恐怖和破坏的基督国王纪念碑(Cristo Rei of Dili)，矗立在阿尔马达的塔霍河南岸，张开双臂俯瞰整座城市，酷似里约热内卢的救世基督像。\n建成于18世纪的圣卡洛斯国家剧院，是里斯本传统的表演艺术中心，主要在秋季和冬季举办相对活跃的文化表演艺术。","see":null,"scope":"reference","qid":"Q597","articleTitle":"里斯本","sourceRevision":94817464,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 里斯本","https://zh.wikipedia.org/wiki/%E9%87%8C%E6%96%AF%E6%9C%AC"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94817464"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q597"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159149431","name":"蓬塔德尔加达","country":"PRT","lat":37.7483,"lon":-25.66658,"kind":"city","region":"PT-20","rank":4,"capital":0,"knowledge":{"theme":"蓬塔德尔加达 · 地点概要","geo":"蓬塔德尔加达1976年宪法修正案后成为自治区的行政首府，司法首府和天主教教区首府保留在群岛原首府英雄港，同时亚速尔立法议会设立在奥尔塔。\n据柯本气候分类法蓬塔德尔加达的气候类型为夏季炎热的地中海式气候。\n如同亚速尔群岛其他地方一样，该市受到墨西哥湾暖流的影响，因此温度变化幅度很窄。","culture":null,"see":null,"scope":"reference","qid":"Q208149","articleTitle":"蓬塔德爾加達","sourceRevision":94746159,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 蓬塔德尔加达","https://zh.wikipedia.org/wiki/%E8%93%AC%E5%A1%94%E5%BE%B7%E7%88%BE%E5%8A%A0%E9%81%94"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94746159"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q208149"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146427","name":"塞图巴尔","country":"PRT","lat":38.52996,"lon":-8.90001,"kind":"city","region":"PT-11","rank":6,"capital":0,"knowledge":{"theme":"塞图巴尔 · 地形、历史与地方特色","geo":"因与里斯本邻近，而拥有巨大的经济、贸易价值，港口、军工业在该市地位重要。","culture":null,"see":"教堂的回廊现已改为市博物馆，收藏有15世纪和16世纪的葡萄牙绘画、弗朗德勒挂毯和绘画、17世纪的首饰和在塞图巴尔市郊发现的出土文物。","scope":"reference","qid":"Q173699","articleTitle":"塞图巴尔","sourceRevision":94630520,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 塞图巴尔","https://zh.wikipedia.org/wiki/%E5%A1%9E%E5%9B%BE%E5%B7%B4%E5%B0%94"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94630520"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q173699"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146429","name":"波尔图","country":"PRT","lat":41.15195,"lon":-8.62195,"kind":"city","region":"PT-13","rank":6,"capital":0},{"id":"city-1159147945","name":"丰沙尔","country":"PRT","lat":32.64998,"lon":-16.88004,"kind":"city","region":"PT-30","rank":6,"capital":0,"knowledge":{"theme":"丰沙尔 · 地形、历史与地方特色","geo":"第一批来到丰沙尔定居的殖民者登录在附近的海岸上，看到了一些野生茴香和一些疑似原始人留下的遗迹。\n丰沙尔所处的山谷形状很像一个半圆形露天剧场，平缓的斜坡从海岸线一支抬升到1,200米，为早期的殖民活动提供了一个天然屏障。\n该种气候一年主要有两个季节：稍有寒冷并多雨的冬季，持续时间为十月到来年三月，日最高气温通常在20°C至25°C之间；稍有炎热并干燥的夏季，持续时间为四月至九月，日最高气温通常在21°C至26°C之间。","culture":"该城建于1421年，丰沙尔来自葡萄牙语中的茴香一词，意味“种植茴香的地方”。\n丰沙尔曾为葡萄牙和美洲之间的重要的贸易转运站，其出产的蔗糖和马德拉酒闻名于世。","see":"如今，丰沙尔是一个重要的旅游城市，其具有相当完善的旅游配套设施：众多酒店，丰沙尔国际机场（FNC），丰沙尔港，众多的博物馆以及阳光沙滩。","scope":"reference","qid":"Q25444","articleTitle":"丰沙尔","sourceRevision":94004473,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 丰沙尔","https://zh.wikipedia.org/wiki/%E4%B8%B0%E6%B2%99%E5%B0%94"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94004473"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q25444"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136119","name":"奥尔塔","country":"PRT","lat":38.53466,"lon":-28.64476,"kind":"city","region":"PT-20","rank":7,"capital":0,"knowledge":{"theme":"奥尔塔 · 地点概要","geo":"奥尔塔有着温和的海洋性气候，据柯本气候分类法，其气候类型为深受地中海式气候影响的亚热带季风气候。\n奥尔塔是葡萄牙亚速尔自治区的市镇，位于亚速尔群岛中部法亚尔岛（包括整个岛屿）。\n亚速尔立法议会位于奥尔塔，因此奥尔塔是亚速尔自治区的立法首府。","culture":null,"see":null,"scope":"reference","qid":"Q990385","articleTitle":"奧爾塔 (亞速爾群島)","sourceRevision":91812421,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 奥尔塔 (亚速尔群岛)","https://zh.wikipedia.org/wiki/%E5%A5%A7%E7%88%BE%E5%A1%94%20%28%E4%BA%9E%E9%80%9F%E7%88%BE%E7%BE%A4%E5%B3%B6%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91812421"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q990385"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136123","name":"英雄港","country":"PRT","lat":38.65039,"lon":-27.21667,"kind":"city","region":"PT-20","rank":7,"capital":0,"knowledge":{"theme":"英雄港 · 地形、历史与地方特色","geo":"英雄港是葡萄牙亚速尔自治区的市镇，位于亚速尔群岛特塞拉岛的西南半部，而岛的西北半部是普拉亚-达维多利亚。\n相传由航海家阿尔瓦罗·马丁斯·奥梅姆建立，最早的文献可以追溯至1439至1949年间，建城的选址为一处山脊，可以像露天剧场般面向两个海湾，中间由一个半岛所分隔，尽处为死火山。\n英雄港气候属地中海式气候（Csa）与副热带湿润气候（Cfa）之间。","culture":"是一个私立的文化协会，致力于调查及研究亚速尔群岛的历史。","see":"1983年英雄港被联合国教科文组织列为世界遗产。","scope":"reference","qid":"Q193677","articleTitle":"英雄港","sourceRevision":91813973,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 英雄港","https://zh.wikipedia.org/wiki/%E8%8B%B1%E9%9B%84%E6%B8%AF"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91813973"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q193677"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136129","name":"波尔蒂芒","country":"PRT","lat":37.13374,"lon":-8.53331,"kind":"city","region":"PT-08","rank":7,"capital":0},{"id":"city-1159136133","name":"法鲁","country":"PRT","lat":37.01708,"lon":-7.93327,"kind":"city","region":"PT-08","rank":7,"capital":0,"knowledge":{"theme":"法鲁 · 地点概要","geo":"法鲁属于地中海型气候（柯本气候分类法，'Csb'），但是受到加那利凉流的调和，此地的夏季不像阿尔加维北部那样受地中海影响而炎热。","culture":null,"see":null,"scope":"reference","qid":"Q159457","articleTitle":"法鲁","sourceRevision":94642753,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 法鲁","https://zh.wikipedia.org/wiki/%E6%B3%95%E9%B2%81"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94642753"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q159457"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136139","name":"科英布拉","country":"PRT","lat":40.20037,"lon":-8.41668,"kind":"city","region":"PT-06","rank":7,"capital":0,"knowledge":{"theme":"科英布拉 · 地形、历史与地方特色","geo":"在12世纪，阿方索·恩里克斯管理着一片肥沃的土地，有河流通过，并受到一座坚固的城市的保护。\n上层城市由贵族和神职人员居住，而下层城市位于蒙德古河河畔，由商人和工匠居住。\n19世纪上半叶是科英布拉的困难时期，在半岛战争期间，科英布拉被安多许·朱诺和安德烈·马塞纳指挥的法国军队入侵。","culture":"建于18世纪的若昂尼纳图书馆是一座巴洛克风格的图书馆，是这所古代大学的另一个著名地标。\n巴洛克大学塔由德国建筑师约翰·弗里德里希·路德维希的团队建造，建于1728年至1733年之间，是这座城市的图书馆。","see":"他们的儿子阿方索·恩里克斯定居在信奉基督教的郡，他派遣探险队前往南部和西部，巩固了包括莱利亚、苏里、拉巴卡尔、阿尔沃吉和安西奥在内的城堡网络。\n年轻的王子鼓励建设他的领地，资助圣克鲁斯修道院（最重要的葡萄牙修道院的机构，成立于1131年），促进了旧大教堂的建设，于1132年重建原始罗马桥，修理和翻新喷泉、窑、道路和石头路面，以及老城的城墙。\n从这个时期开始，圣克鲁斯修道院开始重建，其中就包括包括国王阿方索一世和桑丘一世的坟墓，文艺复兴时期的漫画喷泉，祭坛和旧大教堂的凯旋门，以及其他作品。","scope":"reference","qid":"Q45412","articleTitle":"科英布拉","sourceRevision":93093357,"method":"Full-article section excerpts; traditional Chinese convert