,22.9875],[58.2236,22.8883],[58.1621,22.8815],[57.9328,22.7141],[57.8343,22.5231],[58.0823,21.7106]]]}}],"cities":[{"id":"city-1159150717","name":"马斯喀特","country":"OMN","lat":23.61332,"lon":58.59331,"kind":"city","region":"OM-MA","rank":3,"capital":1,"knowledge":{"theme":"马斯喀特 · 地点概要","geo":"马斯喀特位于阿曼东北部，北回归线通过其南部地区，西部与巴提奈区的平原接壤，东部则与东部区比邻，南部是内地省的平原，而北部则是阿曼湾。\n香水品牌Amouage的总部位于马斯喀特。\n马斯喀特的气候属于热带沙漠气候，有着漫长而炎热的夏季和温暖的冬季。","culture":null,"see":null,"scope":"reference","qid":"Q3826","articleTitle":"马斯喀特","sourceRevision":93442955,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 马斯喀特","https://zh.wikipedia.org/wiki/%E9%A9%AC%E6%96%AF%E5%96%80%E7%89%B9"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=93442955"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q3826"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146587","name":"塞拉莱","country":"OMN","lat":17.02546,"lon":54.08521,"kind":"city","region":"OM-ZU","rank":6,"capital":0,"knowledge":{"theme":"塞拉莱 · 地形、历史与地方特色","geo":"塞拉莱，又译萨拉拉或撒拉拉，是阿曼第二大城市，佐法尔省首府，位于阿曼南部沿海。","culture":null,"see":"塞拉莱的拜利德区和鲁巴特区是祖法儿的古城区。\n阿曼的六座王宫有三座分别在马斯喀特、锡卜、苏哈尔，其余三座都在塞拉莱：城堡王宫、鲁巴特王宫、马穆拉王宫。","scope":"reference","qid":"Q1294439","articleTitle":"塞拉莱","sourceRevision":94652864,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 塞拉莱","https://zh.wikipedia.org/wiki/%E5%A1%9E%E6%8B%89%E8%8E%B1"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94652864"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1294439"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146591","name":"苏哈尔","country":"OMN","lat":24.36197,"lon":56.73442,"kind":"city","region":null,"rank":6,"capital":0,"knowledge":{"theme":"苏哈尔 · 地形、历史与地方特色","geo":"苏哈尔（，Ṣuḥār），阿曼原巴提奈区最大城市，现为北巴提奈省首府，位于马斯喀特西北约240公里。","culture":"传统上，当地经济则以捕鱼、农业、贸易为主，还有铁匠业、银匠业、以椰枣树纤维为材料的纺织业等。\n该地曾被波斯人称作“没巽”（Mazun，或拼作Mezoen），东阿拉伯曾在约公元240年左右为萨珊波斯的阿尔达希尔一世所征服，建立了没巽行省，这个名称用来称呼整个阿曼及其周边地区，如叙利亚文献中的贝特马祖纳耶（Beth Mazunaye）即是地区名和教区名，有时“没巽”（Mazun）也指作为阿曼首府的苏哈尔。","see":null,"scope":"reference","qid":"Q943270","articleTitle":"苏哈尔","sourceRevision":89841004,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 苏哈尔","https://zh.wikipedia.org/wiki/%E8%8B%8F%E5%93%88%E5%B0%94"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=89841004"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q943270"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146593","name":"锡卜","country":"OMN","lat":23.68025,"lon":58.18254,"kind":"city","region":"OM-MA","rank":6,"capital":0,"knowledge":{"theme":"锡卜 · 地点概要","geo":"锡卜（；英语：As Sib或Seeb），阿曼东北部马斯喀特地区沿海一城市。\n当地有阿曼最主要的民用机场锡卜国际机场和海湾地区重要的空军基地锡卜空军基地。","culture":null,"see":null,"scope":"reference","qid":"Q948050","articleTitle":"锡卜","sourceRevision":89850645,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 锡卜","https://zh.wikipedia.org/wiki/%E9%94%A1%E5%8D%9C"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=89850645"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q948050"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159148149","name":"尼兹瓦","country":"OMN","lat":22.92639,"lon":57.53141,"kind":"city","region":"OM-DA","rank":6,"capital":0,"knowledge":{"theme":"尼兹瓦 · 地形、历史与地方特色","geo":"尼兹瓦，又译作尼日瓦或奈兹瓦，是阿曼内地省最大的城市，位于马斯喀特西南约200公里。","culture":"尼兹瓦历史上是阿曼教长国古都之一，后于1955年被马斯喀特军队在英国军队的协助下攻占，城市也在战斗中受到巨大破坏。","see":null,"scope":"reference","qid":"Q1915327","articleTitle":"尼兹瓦","sourceRevision":94430942,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 尼兹瓦","https://zh.wikipedia.org/wiki/%E5%B0%BC%E5%85%B9%E7%93%A6"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94430942"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1915327"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159148153","name":"苏尔","country":"OMN","lat":22.57582,"lon":59.5348,"kind":"city","region":null,"rank":6,"capital":0,"knowledge":{"theme":"苏尔 · 地点概要","geo":"苏尔（阿拉伯语：）是阿曼东部区的首府，濒临阿曼湾，苏尔位于首都马斯喀特之东南方约150公里。\n苏尔当地是炎热的沙漠气候，降雨量很少，而且温度很高，即使夜间温度也不会很低。","culture":null,"see":null,"scope":"reference","qid":"Q737270","articleTitle":"苏尔 (阿曼)","sourceRevision":92224375,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 苏尔 (阿曼)","https://zh.wikipedia.org/wiki/%E8%8B%8F%E5%B0%94%20%28%E9%98%BF%E6%9B%BC%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=92224375"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q737270"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159137881","name":"米尔巴特","country":"OMN","lat":16.99244,"lon":54.69179,"kind":"city","region":"OM-ZU","rank":7,"capital":0},{"id":"city-1159137899","name":"伊比利","country":"OMN","lat":23.22539,"lon":56.51695,"kind":"city","region":"OM-ZA","rank":7,"capital":0,"knowledge":{"theme":"伊比利 · 地形、历史与地方特色","geo":"伊卜里是阿曼扎希拉省最大的城市，位于扎希拉省北部，是北扎希拉地区的首府，距离阿曼第一大城市马斯喀特约300千米。\n伊卜里坐落在海拔359米以上，其绿洲闻名于它的油田比其他几乎任何地方都要多。","culture":"在历史上，伊卜里以其贸易市场和盛产的水果而闻名。","see":"伊卜里拥有着独特的考古遗址，譬如伊卜里城堡、蝙蝠墓地等。\n伊卜里拥有许多景点，包括苏拉衣夫城堡、阿斯瓦德城堡、伊卜里城堡和蝙蝠墓地。","scope":"reference","qid":"Q225376","articleTitle":"伊卜里","sourceRevision":94561835,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 伊卜里","https://zh.wikipedia.org/wiki/%E4%BC%8A%E5%8D%9C%E9%87%8C"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94561835"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q225376"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159128941","name":"阿拉亚特萨迈勒","country":"OMN","lat":23.30319,"lon":57.97821,"kind":"city","region":"OM-DA","rank":8,"capital":0},{"id":"city-1159132343","name":"希尔夫","country":"OMN","lat":20.65615,"lon":58.87676,"kind":"city","region":null,"rank":8,"capital":0}]}