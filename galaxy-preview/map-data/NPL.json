[83.0034,27.9464],[82.846,27.9023],[82.7624,27.8247],[82.844,27.7759],[82.7165,27.7605],[82.6739,27.6965]]]}},{"id":"NP-BH","name":"佩里专区","english":"Bheri","country":"NPL","lat":28.4501,"lon":81.7802,"kind":"region","bbox":[80.9972,27.8509,82.5681,29.1257],"geometry":{"type":"Polygon","coordinates":[[[82.0502,27.9056],[81.9759,27.917],[81.8557,27.8509],[81.4735,28.0664],[81.396,28.1606],[81.2962,28.1283],[81.2768,28.1538],[81.2959,28.1675],[81.1697,28.3613],[81.0471,28.3891],[81.0704,28.4576],[81.2719,28.6361],[81.2771,28.6972],[81.2182,28.8414],[81.1904,28.8595],[81.2108,28.8117],[81.1358,28.8664],[81.0949,28.854],[80.9972,28.9471],[81.0541,28.9762],[81.2077,28.908],[81.4424,28.8985],[81.5166,28.8083],[81.5232,28.7492],[81.5694,28.781],[81.4078,29.0032],[81.4573,29.0708],[81.5486,29.1257],[81.5805,29.0525],[81.8449,28.9812],[81.9253,28.9748],[82.015,29.011],[82.0767,28.9791],[82.169,29.0658],[82.2837,29.1079],[82.405,29.0878],[82.413,29.0023],[82.5681,28.9852],[82.4842,28.8768],[82.3174,28.7696],[82.1858,28.6248],[82.0438,28.6317],[82.0083,28.5937],[82.0195,28.4878],[81.9556,28.4265],[81.9807,28.3452],[82.0416,28.3229],[82.095,28.2485],[82.0421,28.2238],[82.0132,28.1598],[82.1805,28.0154],[82.1662,27.9577],[82.091,27.9465],[82.0502,27.9056]]]},"knowledge":{"theme":"佩里专区 · 地点概要","geo":"佩里专区（尼泊尔语：भेरी अञ्चल，IAST：Bherī añcal；英语：Bheri zone）是尼泊尔的十四个行政专区之一，属于中西部发展区。\n扎泽尔果德县 जाजरकोट Jājarkoṭ。","culture":null,"see":null,"scope":"reference","qid":"Q9060","articleTitle":"佩里專區","sourceRevision":91989541,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 佩里专区","https://zh.wikipedia.org/wiki/%E4%BD%A9%E9%87%8C%E5%B0%88%E5%8D%80"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91989541"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q9060"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}],"cities":[{"id":"city-1159150655","name":"加德满都","country":"NPL","lat":27.71864,"lon":85.3147,"kind":"city","region":"NP-BA","rank":3,"capital":1,"knowledge":{"theme":"加德满都 · 地形、历史与地方特色","geo":"城市所在的山谷在历史上被称为，因此加德满都一直是喜马拉雅山脉山麓中内瓦尔人文明的重要城镇，近代，加德满都曾作为尼泊尔王国的皇家首都，并设有尼泊尔皇室的宫殿、豪宅和花园等。\n这座城市被认为是尼泊尔通往喜马拉雅山的门户，城市多处史迹被指定为世界遗产：包括加德满都王宫广场、斯瓦扬布纳特、满愿塔及帕舒帕蒂纳特庙，根据世界银行2010年的数据，加德满都每年正以4%的速度增长，使其成为南亚增长最快的大都市区之一，也是尼泊尔第一个面临快速城市化和现代化挑战的城市，目前也是位于喜马拉雅山脉中最大的都会区。\n加德满都的空气污染严重，除了工业污染，城区交通拥挤，老旧的车辆排放大量超标废气之外，寺庙焚烧大量物品也是造成空气污染的一个重要原因，加德满都地处盆地的谷底，四周的高山阻挡了空气流动，加重了污染程度。","culture":"加德满都是世界上最古老有人居住的城市之一，也是自古为尼泊尔的政治文化中心与文明交流要冲，该城市始建于公元2世纪。\n15世纪末，马拉王朝分裂，加德满都、帕坦和巴德岗等城市各自成为独立王国，河谷地区形成三足鼎立局面。","see":null,"scope":"reference","qid":"Q3037","articleTitle":"加德滿都","sourceRevision":93416223,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 加德满都","https://zh.wikipedia.org/wiki/%E5%8A%A0%E5%BE%B7%E6%BB%BF%E9%83%BD"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=93416223"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q3037"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136491","name":"尼泊尔根杰","country":"NPL","lat":28.05034,"lon":81.61666,"kind":"city","region":"NP-BH","rank":7,"capital":0,"knowledge":{"theme":"尼泊尔根杰 · 地形、历史与地方特色","geo":"尼泊尔根杰拥有多元文化，来自不同信仰的人生活在混合社区中。\n该市还拥有伊斯兰教，锡克教和基督教等其他宗教的信徒。","culture":"众所周知，不同种族的人传统上生活在一起，没有任何重大冲突。","see":null,"scope":"reference","qid":"Q1025462","articleTitle":"尼泊爾根傑","sourceRevision":94704530,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 尼泊尔根杰","https://zh.wikipedia.org/wiki/%E5%B0%BC%E6%B3%8A%E7%88%BE%E6%A0%B9%E5%82%91"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94704530"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1025462"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136495","name":"比爾甘傑","country":"NPL","lat":27.00041,"lon":84.86659,"kind":"city","region":"NP-NA","rank":7,"capital":0,"knowledge":{"theme":"比爾甘傑 · 地点概要","geo":"比尔甘杰是拉纳王朝首相莫汉·苏姆谢尔·忠格·巴哈杜尔·拉纳统治期间最早成立的三个城市之一。\n它于2017年5月22日与比兰德拉纳加尔和博卡拉一起被宣布为大都会城市。","culture":null,"see":null,"scope":"reference","qid":"Q8252","articleTitle":"比爾根傑","sourceRevision":87635767,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 比尔根杰","https://zh.wikipedia.org/wiki/%E6%AF%94%E7%88%BE%E6%A0%B9%E5%82%91"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=87635767"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q8252"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159136499","name":"比拉德讷格尔","country":"NPL","lat":26.48374,"lon":87.28334,"kind":"city","region":"NP-KO","rank":7,"capital":0},{"id":"city-1159146011","name":"博克拉","country":"NPL","lat":28.264,"lon":83.972,"kind":"city","region":"NP-GA","rank":7,"capital":0,"knowledge":{"theme":"博克拉 · 地形、历史与地方特色","geo":"博克拉四面环山，安娜普纳山脉终年积雪，位于博克拉市西北的鱼尾峰（马查策莱峰）海拔6993米, 鱼尾峰附近是安纳普尔那山脉。\n博克拉属热带海洋性季风气候，温暖湿润，6月至9月，由于博克拉南方没有不可逾越的屏障来抵挡春季和季风季的雨云，因此降雨量格外丰沛。\n山脉有海拔8091米的安纳普尔那1号峰,7555米的安纳普尔那3号峰和7219米的安纳普尔那南峰。","culture":"历史上曾是西藏和印度之间重要的的贸易中转站。\n博克拉曾是西藏和印度之间重要的贸易通道，该地曾被卡斯基人统治，后来又被沙阿王朝统治，博克拉周围的大山还有中世纪的遗迹。","see":"贝格纳斯湖、鲁帕湖、马享德拉溶洞、戴维斯瀑布、色提河峡谷和西藏难民营。","scope":"reference","qid":"Q6640","articleTitle":"博卡拉","sourceRevision":92274728,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 博卡拉","https://zh.wikipedia.org/wiki/%E5%8D%9A%E5%8D%A1%E6%8B%89"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=92274728"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q6640"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159128413","name":"勒利德布尔","country":"NPL","lat":27.66662,"lon":85.33333,"kind":"city","region":"NP-BA","rank":8,"capital":0,"knowledge":{"theme":"勒利德布尔 · 地形、历史与地方特色","geo":"拉利特普尔，旧称帕坦，是尼泊尔中部的一座城市，为尼泊尔第二大城市。\n拉利特普尔是一座历史文化名城，市内多宗教寺庙和佛塔。","culture":null,"see":"1979年，市内著名的帕坦王宫广场作为加德满都谷地的一部分，被联合国教科文组织列为世界遗产。","scope":"reference","qid":"Q6647","articleTitle":"拉利特普尔 (尼泊尔)","sourceRevision":87459905,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 拉利特普尔 (尼泊尔)","https://zh.wikipedia.org/wiki/%E6%8B%89%E5%88%A9%E7%89%B9%E6%99%AE%E5%B0%94%20%28%E5%B0%BC%E6%B3%8A%E5%B0%94%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=87459905"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q6647"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159128419","name":"黑道達","country":"NPL","lat":27.41668,"lon":85.03335,"kind":"city","region":"NP-NA","rank":8,"capital":0},{"id":"city-1159114955","name":"萨利安","country":"NPL","lat":28.35,"lon":82.1833,"kind":"city","region":"NP-RA","rank":10,"capital":0},{"id":"city-1159116171","name":"巴格隆","country":"NPL","lat":28.2667,"lon":83.5833,"kind":"city","region":"NP-DH","rank":10,"capital":0,"knowledge":{"theme":"巴格隆 · 地点概要","geo":"巴格隆是尼泊尔西部的一个镇，距尼泊尔首都加德满都275km。\n巴格隆是卡利甘达基山谷中的人民的一个主要的商业，金融，教育，医疗中心。","culture":null,"see":null,"scope":"reference","qid":"Q1659597","articleTitle":"巴格隆","sourceRevision":94768026,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables