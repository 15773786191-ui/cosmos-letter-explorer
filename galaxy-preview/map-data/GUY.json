57.9366,6.4516],[-57.9335,6.5327],[-57.8828,6.5376],[-57.9139,6.7128]]]}}],"cities":[{"id":"city-1159150585","name":"乔治敦","country":"GUY","lat":6.80197,"lon":-58.16703,"kind":"city","region":"GY-EB","rank":3,"capital":1,"knowledge":{"theme":"乔治敦 · 地点概要","geo":"佐治敦地处热带雨林气候区，年均温介于24°C至32°C之间，年降雨量约2300毫米，分为明显的雨季（5月至7月及11月至次年1月）和旱季（2月至4月及8月至10月）。\n根据柯本气候分类法，乔治城属热带雨林气候，全年高温多雨无干季，又因受来自大西洋的东北信风吹拂，其平均高温并不非常高。\n位于德梅拉拉河的右岸有切迪·贾根国际机场，连接盖亚那与他国的交通，另于乔治城附近亦有，可作为前往其他加勒比共同体成员国与区域性交通的媒介。","culture":null,"see":null,"scope":"reference","qid":"Q10717","articleTitle":"乔治敦 (圭亚那)","sourceRevision":93033064,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 乔治敦 (圭亚那)","https://zh.wikipedia.org/wiki/%E4%B9%94%E6%B2%BB%E6%95%A6%20%28%E5%9C%AD%E4%BA%9A%E9%82%A3%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=93033064"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q10717"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146349","name":"林登","country":"GUY","lat":5.99001,"lon":-58.26997,"kind":"city","region":"GY-UT","rank":6,"capital":0},{"id":"city-1159147651","name":"马巴鲁马","country":"GUY","lat":8.19998,"lon":-59.77998,"kind":"city","region":"GY-BA","rank":6,"capital":0,"knowledge":{"theme":"马巴鲁马 · 地点概要","geo":"马巴鲁马（Mabaruma）是位于圭亚那北部与委内瑞拉交界处的一座城市，海拔13米。","culture":null,"see":null,"scope":"reference","qid":"Q597458","articleTitle":"马巴鲁马","sourceRevision":66774631,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 马巴鲁马","https://zh.wikipedia.org/wiki/%E9%A9%AC%E5%B7%B4%E9%B2%81%E9%A9%AC"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=66774631"],["地点身份 · Wikidata","