[31.6895,12.5926],[31.468,12.7029],[31.2707,12.6155],[31.147,12.6233],[31.0878,12.5909],[30.9853,12.4412],[30.8435,12.3729],[30.731,12.2757],[30.6526,12.2784],[30.5806,12.3182],[30.4155,12.4989],[30.0518,12.5049],[30.0156,12.548],[30.0161,12.675],[29.9641,12.7285],[29.8424,12.7282],[29.7695,12.6852]]]},"knowledge":{"theme":"北科尔多凡省 · 地点概要","geo":"北科尔多凡州是苏丹的一个州，位于该国中部。","culture":null,"see":null,"scope":"reference","qid":"Q864093","articleTitle":"北科尔多凡州","sourceRevision":89831646,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 北科尔多凡州","https://zh.wikipedia.org/wiki/%E5%8C%97%E7%A7%91%E5%B0%94%E5%A4%9A%E5%87%A1%E5%B7%9E"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=89831646"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q864093"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}],"cities":[{"id":"city-1159151275","name":"喀土穆","country":"SDN","lat":15.59002,"lon":32.53223,"kind":"city","region":"SD-KH","rank":2,"capital":1,"knowledge":{"theme":"喀土穆 · 地形、历史与地方特色","geo":"作为苏丹的政治、经济与文化中心，喀土穆位于白尼罗河与青尼罗河交汇处，形成独特的「三城联邦」，由喀土穆本城、北喀土穆及恩图曼组成，以桥梁相互连接，合称「大喀土穆」。\n其名称「喀土穆」在阿拉伯语中意为「大象鼻子」，形容尼罗河交汇处的狭长地形。\n喀土穆地处热带沙漠气候区，是世界上最炎热的主要城市之一，夏季气温可达53°C以上，年均降水量仅约155毫米，集中于7月至8月。","culture":"喀土穆是苏丹的经济与交通枢纽，拥有连接苏丹港与欧拜伊德的铁路线，以及喀土穆国际机场。\n喀土穆于1821年由埃及的穆罕默德·阿里帕夏建城，作为埃及军队的据点。","see":"城市核心文化机构包括苏丹国家博物馆、哈里发故居博物馆、历史悠久的喀土穆大学，以及苏丹科技大学等。","scope":"reference","qid":"Q1963","articleTitle":"喀土穆","sourceRevision":89832539,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 喀土穆","https://zh.wikipedia.org/wiki/%E5%96%80%E5%9C%9F%E7%A9%86"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=89832539"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1963"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159150607","name":"苏丹港","country":"SDN","lat":19.61579,"lon":37.21643,"kind":"city","region":"SD-RS","rank":3,"capital":0,"knowledge":{"theme":"苏丹港 · 地形、历史与地方特色","geo":"位于城南20公里处，开通有飞往喀土穆、迪拜、开罗、伊斯坦布尔、吉达等地的航线。\n苏丹港为热带沙漠气候，夏季极其炎热，冬季中度炎热，需要从中的瓦迪阿尔巴特河获取淡水。","culture":"苏丹港建于1905年，作为喀土穆到红海铁路运输线的终点而建造，取代南部的小港萨瓦金。\n1904年，英国统治当局修建了连接喀土穆与红海的铁路，苏丹港作为这条铁路的终点很快繁荣起来。","see":null,"scope":"reference","qid":"Q208718","articleTitle":"苏丹港 (城市)","sourceRevision":93913840,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 苏丹港 (城市)","https://zh.wikipedia.org/wiki/%E8%8B%8F%E4%B8%B9%E6%B8%AF%20%28%E5%9F%8E%E5%B8%82%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=93913840"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q208718"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159150629","name":"尼亚拉","country":"SDN","lat":12.05997,"lon":24.88999,"kind":"city","region":"SD-DS","rank":3,"capital":0},{"id":"city-1159150633","name":"栋古拉","country":"SDN","lat":19.16659,"lon":30.4833,"kind":"city","region":"SD-NO","rank":3,"capital":0},{"id":"city-1159150637","name":"卡薩拉","country":"SDN","lat":15.45997,"lon":36.39002,"kind":"city","region":"SD-KA","rank":3,"capital":0,"knowledge":{"theme":"卡薩拉 · 地点概要","geo":"自1960年代起，大量埃塞俄比亚和厄立特里亚的难民为逃避战乱而迁入卡萨拉。\n自1980年代第二次苏丹内战，避难人群从苏丹的南部和西部逃至卡萨拉。","culture":null,"see":null,"scope":"reference","qid":"Q686813","articleTitle":"卡薩拉","sourceRevision":94287440,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 卡萨拉","https://zh.wikipedia.org/wiki/%E5%8D%A1%E8%96%A9%E6%8B%89"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94287440"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q686813"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159149441","name":"朱奈纳","country":"SDN","lat":13.45002,"lon":22.44001,"kind":"city","region":"SD-DW","rank":4,"capital":0},{"id":"city-1159149453","name":"恩图曼","country":"SDN","lat":15.61668,"lon":32.48002,"kind":"city","region":"SD-KH","rank":4,"capital":0,"knowledge":{"theme":"恩图曼 · 地点概要","geo":"恩图曼，又译乌姆杜尔曼，苏丹喀土穆州的一座城市，位于尼罗河西岸，与喀土穆和北喀土穆隔河相望，三地有桥梁相连。","culture":null,"see":null,"scope":"reference","qid":"Q180921","articleTitle":"恩图曼","sourceRevision":91207291,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 恩图曼","https://zh.wikipedia.org/wiki/%E6%81%A9%E5%9B%BE%E6%9B%BC"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91207291"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q180921"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159149455","name":"欧拜伊德","country":"SDN","lat":13.18329,"lon":30.2167,"kind":"city","region":"SD-KN","rank":4,"capital":0,"knowledge":{"theme":"欧拜伊德 · 地形、历史与地方特色","geo":"城市位于交通要道:有欧拜伊德机场，是铁路的终点，很多国道和驼路的交汇点，还是从尼日利亚前来的朝圣路的终点。","culture":"欧拜伊德拥有苏丹最大的大学之一，科尔多凡大学在大学法语系的合作下，城市设立了苏丹-法国文化中心在修筑了沥青路和一些私家巴士公司建立之后，欧拜伊德和喀土穆之间的交通便利了不少。","see":null,"scope":"reference","qid":"Q309475","articleTitle":"欧拜伊德","sourceRevision":94748057,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 欧拜伊德","https://zh.wikipedia.org/wiki/%E6%AC%A7%E6%8B%9C%E4%BC%8A%E5%BE%B7"],["原文版本