],[91.2371,27.0314],[91.3453,27.0878],[91.3795,27.1629]]]},"knowledge":{"theme":"佩马加策尔宗 · 地点概要","geo":"佩马加策尔宗 是不丹的一个宗，位于该国东南部。","culture":null,"see":null,"scope":"reference","qid":"Q167279","articleTitle":"佩马加策尔宗","sourceRevision":86378098,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 佩马加策尔宗","https://zh.wikipedia.org/wiki/%E4%BD%A9%E9%A9%AC%E5%8A%A0%E7%AD%96%E5%B0%94%E5%AE%97"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=86378098"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q167279"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}],"cities":[{"id":"city-1159151151","name":"廷布","country":"BTN","lat":27.47299,"lon":89.63901,"kind":"city","region":"BT-15","rank":3,"capital":1,"knowledge":{"theme":"廷布 · 地形、历史与地方特色","geo":"廷布，又译为辛布、亭孚、亭布等，是不丹王国的首都。","culture":"自1955年以来，廷布一直是不丹王国的政治、经济、军事、文化和宗教的中心。\n廷布最早建设于13世纪，不丹宗教之父帕久·竹贡西博（Phajo Drugom Zhigpo）喇嘛在此处修建了小寺庙。","see":null,"scope":"reference","qid":"Q9270","articleTitle":"廷布","sourceRevision":94791516,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 廷布","https://zh.wikipedia.org/wiki/%E5%BB%B7%E5%B8%83"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94791516"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q9270"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159121163","name":"帕罗","country":"BTN","lat":27.42937,"lon":89.41678,"kind":"city","region":"BT-15","rank":10,"capital":0,"knowledge":{"theme":"帕罗 · 地点概要","geo":"帕罗（；拉丁化：Paro）是不丹帕罗宗的首府，位于不丹西部的帕罗河谷，坐落有不丹唯一的国际机场帕罗机场。\n帕罗市中心6公里处坐落有不丹唯一的国际机场帕罗机场，四周被高山包围，仅有一条跑道，地势险要，被广泛认为是起降难度较高的机场，基地航空公司包括不丹航空与不丹皇家航空。\n帕罗平均海拔2250公尺，坐落在河谷高原上，为典型的亚热带高原气候。","culture":null,"see":null,"scope":"reference","qid":"Q862041","articleTitle":"帕羅","sourceRevision":91622441,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 帕罗","https://zh.wikipedia.org/wiki/%E5%B8%95%E7%BE%85"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91622441"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q862041"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159121181","name":"普那卡","country":"BTN","lat":27.58415,"lon":89.86414,"kind":"city","region":"BT-23","rank":10,"capital":0,"knowledge":{"theme":"普那卡 · 地形、历史与地方特色","geo":"普那卡是不丹王国的古首都（1955年政府迁都廷布），位于中北部，海拔1300米。\n据说莲花生曾经预言说：“一位名叫南结的人将在卧象形状的丘陵建立城堡”，在17世纪夏仲阿旺南结（Zhabs-drung ngag-dbang rnam-rgyal）来到了普那卡，发现有一座丘陵形状与卧象十分相似，并在象鼻尖（丘陵的最低处）修建了城堡，应验了千年前的预言。","culture":null,"see":"雄伟壮观的普那卡城堡是不丹第二座大城堡，修建于1577年，处于Pho-chu（“公河”）和Mo-chu（“母河”）交汇处。","scope":"reference","qid":"Q826112","articleTitle":"普那卡","sourceRevision":90517774,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 普那卡","https://zh.wikipedia.org/wiki/%E6%99%AE%E9%82%A3%E5%8D%A1"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=90517774"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q826112"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159121217","name":"旺杜波德朗","country":"BTN","lat":27.4333,"lon":89.9167,"kind":"city","region":"BT-24","rank":10,"capital":0,"knowledge":{"theme":"旺杜波德朗 · 地形、历史与地方特色","geo":"旺杜波德朗位于不丹莫河与唐河（Tang-chhu）的汇合处，平均海拔1310米。","culture":"旺杜波德朗建立于1638年，由不丹的建国者夏仲阿旺朗杰命名。\n2012年，旺杜波德朗发生大火，含当地的宗教中心旺杜波德朗宗的整座城市都遭到烧毁或不同程度的毁损。","see":null,"scope":"reference","qid":"Q1715095","articleTitle":"旺杜波德朗","sourceRevision":89888137,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 旺杜波德朗","https://zh.wikipedia.org/wiki/%E6%97%BA%E6%9D%9C%E6%B3%A2%E5%BE%B7%E6%9C%97"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=89888137"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1715095"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}]}