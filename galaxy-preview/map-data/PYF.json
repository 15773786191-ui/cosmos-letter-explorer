,-9.8035],[-139.0619,-9.8539],[-139.1435,-9.8289],[-139.1732,-9.7742],[-139.0154,-9.6944],[-138.9427,-9.7424],[-138.8366,-9.7411]]],[[[-140.0767,-9.3234],[-140.0277,-9.3439],[-140.0629,-9.436],[-140.0928,-9.4475],[-140.1586,-9.3718],[-140.0767,-9.3234]]],[[[-139.5144,-8.884],[-139.5084,-8.912],[-139.6168,-8.9542],[-139.6304,-8.8954],[-139.5969,-8.858],[-139.5144,-8.884]]],[[[-140.0494,-8.8232],[-140.0192,-8.8964],[-140.0556,-8.8785],[-140.0767,-8.9152],[-140.1177,-8.9057],[-140.1832,-8.9537],[-140.2277,-8.927],[-140.2611,-8.8232],[-140.2167,-8.781],[-140.0277,-8.789],[-140.0494,-8.8232]]],[[[-140.6925,-8.0151],[-140.7272,-8.0281],[-140.7064,-7.9631],[-140.6384,-7.9597],[-140.6925,-8.0151]]]]}}],"cities":[{"id":"city-1159150449","name":"帕皮提","country":"PYF","lat":-17.53336,"lon":-149.56667,"kind":"city","region":"PF-X01~","rank":4,"capital":0,"knowledge":{"theme":"帕皮提 · 地形、历史与地方特色","geo":"根据柯本气候分类法，帕皮提属于热带季风气候（Am），有雨季和旱季，与热带雨林气候区接壤，全年高温高湿。\n帕皮提是法国海外集体法属玻里尼西亚向风群岛行政区的一个市镇，也是法属波利尼西亚的首府，位于大溪地岛。\n帕皮提面积，位于法国海外集体法属玻里尼西亚社会群岛向风群岛的大溪地岛。","culture":"1820年，塔希提王国女王波马雷四世在此营造新都，是为帕皮提建城之始，1842年塔希提沦为法国保护国后仍然以帕皮提为都。","see":"这里也曾是塔希提女王波马雷四世的皇家住所和宫殿所在地，她于 1827 年至 1877 年统治该地。","scope":"reference","qid":"Q130800","articleTitle":"帕皮提","sourceRevision":87150774,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 帕皮提","https://zh.wikipedia.org/wiki/%E5%B8%95%E7%9A%AE%E6%8F%90"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=87150774"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q130800"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}]}