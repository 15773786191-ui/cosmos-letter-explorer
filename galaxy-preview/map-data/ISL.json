5%B3%B6%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94485002"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q241551"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}],"cities":[{"id":"city-1159150587","name":"雷克雅未克","country":"ISL","lat":64.15002,"lon":-21.95002,"kind":"city","region":"IS-2","rank":3,"capital":1,"knowledge":{"theme":"雷克雅未克 · 地形、历史与地方特色","geo":"另外，冰岛第二大机场雷克雅未克机场和第一大机场凯夫拉维克机场亦位于雷克雅未克及其附近区域，但飞机主要在国内航行或是飞往格陵兰、法罗群岛等离冰岛较近的地区。\n虽然雷克雅维克位处北极圈附近，但由于在冬季受到墨西哥湾暖流和北大西洋暖流的影响，其气候比起莫斯科、渥太华等同样位处北极圈附近的城市要暖和许多，属于近极地海洋性气候。\n雷克雅维克（冰岛文：，）为冰岛的首都和最大城市，全国、经济和政治中心，位于冰岛西南部的法赫萨湾南岸，所在纬度为北纬64度08分，是全世界最北端的主权国家首都。","culture":"据《殖民之书》记载，公元874年英格尔夫·阿纳尔松在雷克雅未克建立定居点，被认为是冰岛的第一个永久定居点，而直到19世纪，雷克雅未克都还未有城市规划。\n历史上，雷克雅维克曾分别隶属于挪威和丹麦。","see":"现时，冰岛政府大楼、议会大厅、国家博物馆等机构均设于雷克雅维克。","scope":"reference","qid":"Q1764","articleTitle":"雷克雅維克","sourceRevision":94223125,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 雷克雅维克","https://zh.wikipedia.org/wiki/%E9%9B%B7%E5%85%8B%E9%9B%85%E7%B6%AD%E5%85%8B"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94223125"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1764"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159146353","name":"赫本","country":"ISL","lat":64.27232,"lon":-15.21386,"kind":"city","region":"IS-7","rank":6,"capital":0},{"id":"city-1159147671","name":"伊萨菲厄泽","country":"ISL","lat":66.08332,"lon":-23.14997,"kind":"city","region":"IS-4","rank":6,"capital":0,"knowledge":{"theme":"伊萨菲厄泽 · 地点概要","geo":"| native_name = Ísafjörður。\n| native_name_lang = is。","culture":null,"see":null,"scope":"reference","qid":"Q106896","articleTitle":"伊萨菲厄泽","sourceRevision":92000079,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, 