edia.org/w/index.php?oldid=93416231"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q3844"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"CG-11","name":"布恩扎省","english":"Bouenza","country":"COG","lat":-4.36333,"lon":13.491,"kind":"region","bbox":[12.6072,-4.783,14.3773,-3.4558],"geometry":{"type":"Polygon","coordinates":[[[13.8763,-4.4917],[13.8105,-4.4267],[13.715,-4.453],[13.7125,-4.6857],[13.5799,-4.783],[13.5625,-4.7269],[13.3927,-4.6295],[13.2546,-4.4119],[13.0642,-4.3776],[12.999,-4.3334],[12.8516,-4.0757],[12.6072,-3.8171],[12.6448,-3.7587],[12.6311,-3.5499],[12.7012,-3.5194],[12.7393,-3.5598],[12.7959,-3.5623],[12.8901,-3.7317],[12.8748,-3.7629],[12.8998,-3.8322],[13.0234,-3.9234],[13.3468,-3.928],[13.3747,-4.0333],[13.443,-4.0522],[13.5078,-4.0288],[13.5212,-3.9528],[13.5978,-3.8318],[13.5687,-3.7681],[13.7172,-3.7331],[13.7801,-3.6159],[13.8603,-3.5384],[14.0325,-3.5723],[14.1441,-3.4558],[14.2431,-3.5003],[14.3075,-3.6323],[14.2128,-3.6907],[14.3773,-3.9514],[14.3221,-4.0067],[14.2395,-3.9856],[14.1439,-4.0948],[14.1514,-4.1705],[13.969,-4.2745],[13.9054,-4.4901],[13.8763,-4.4917]]]}},{"id":"CG-9","name":"尼阿里省","english":"Niari","country":"COG","lat":-2.97914,"lon":12.3646,"kind":"region","bbox":[11.5307,-4.8853,13.5799,-1.8265],"geometry":{"type":"Polygon","coordinates":[[[13.3926,-4.8853],[13.3588,-4.7948],[13.1821,-4.6861],[13.1124,-4.5769],[13.0715,-4.6016],[13.0737,-4.6353],[12.922,-4.5023],[12.8699,-4.412],[12.8011,-4.41],[12.7064,-4.3338],[12.5908,-4.3195],[12.5481,-4.2565],[12.5521,-4.1711],[12.3844,-3.9946],[12.2126,-3.9475],[12.2024,-3.9151],[12.0619,-3.8665],[11.8609,-3.7412],[11.8408,-3.71],[11.9055,-3.6435],[11.8349,-3.5921],[11.8278,-3.5481],[11.8984,-3.3892],[11.9549,-3.3355],[11.9444,-3.3032],[11.6875,-3.171],[11.7064,-3.0499],[11.7537,-3.0423],[11.7784,-3.0057],[11.6368,-2.8333],[11.5307,-2.8667],[11.5375,-2.7977],[11.6244,-2.6328],[11.5765,-2.5025],[11.5662,-2.3297],[11.6559,-2.3456],[11.7561,-2.