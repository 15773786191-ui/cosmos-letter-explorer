:{"type":"Polygon","coordinates":[[[-76.829,25.5317],[-76.8094,25.5294],[-76.8721,25.5066],[-76.829,25.5317]]]}}],"cities":[{"id":"city-1159151207","name":"拿骚","country":"BHS","lat":25.08339,"lon":-77.35004,"kind":"city","region":null,"rank":3,"capital":1,"knowledge":{"theme":"拿骚 · 地形、历史与地方特色","geo":"拿骚位于新普罗维登斯岛，是巴哈马的首都（该城市亦曾为海盗共和国首都），也是该国的第一大城市和商业、政治、文化中心。\n位于拿骚以东海上天堂岛的亚特兰蒂斯度假中心是闻名世界的旅游胜地。","culture":"1660年建镇，以查理二世命名查尔斯顿，在骚乱火灾后于1695年重建，以当时在位的 威廉三世之奥兰治-拿骚王朝改名拿骚。","see":null,"scope":"reference","qid":"Q2467","articleTitle":"拿骚 (巴哈马)","sourceRevision":92132294,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 拿骚 (巴哈马)","https://zh.wikipedia.org/wiki/%E6%8B%BF%E9%AA%9A%20%28%E5%B7%B4%E5%93%88%E9%A9%AC%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=92132294"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q2467"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159150453","name":"自由港","country":"BHS","lat":26.53328,"lon":-78.70001,"kind":"city","region":"BS-WG","rank":4,"capital":0}]}