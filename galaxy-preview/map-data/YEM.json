,14.9329],[44.635,15.0262],[44.7551,15.012],[44.8687,14.7562],[44.7925,14.6668],[44.7491,14.4276],[44.6304,14.2766],[44.3534,14.3738],[44.253,14.4436],[44.2089,14.3767],[44.1377,14.3649],[44.1015,14.4337],[43.9625,14.3353],[43.9729,14.2566],[43.9459,14.2085],[43.8797,14.1979],[43.8657,14.2455],[43.7976,14.114],[43.7257,14.076]]]}},{"id":"YE-SA","name":"萨那","english":"Amanat Al Asimah","country":"YEM","lat":15.3494,"lon":44.2115,"kind":"region","bbox":[44.122,15.2934,44.3994,15.6119],"geometry":{"type":"Polygon","coordinates":[[[44.3194,15.6119],[44.3994,15.5492],[44.3684,15.5334],[44.3533,15.5564],[44.3331,15.5197],[44.2827,15.5125],[44.2329,15.4289],[44.2582,15.3208],[44.1811,15.2934],[44.1385,15.369],[44.1652,15.4123],[44.122,15.4649],[44.1796,15.4851],[44.2099,15.5521],[44.3194,15.6119]]]},"knowledge":{"theme":"萨那 · 地形、历史与地方特色","geo":"萨那位于海拔的高原上，距离亚丁320公里。\n萨那属于沙漠气候，但相对较潮湿，平均年降水量约200毫米。\n由于当地海拔较高，城市气温比阿拉伯半岛的其他地区相比要明显低，一年最高温度平均为23.42摄氏度，最底温度平均为10.93摄氏度。","culture":"前者面积较小，保留城市古老的文化遗产，保存老的商业生活方式，而新城则是由郊区城市化扩张而来，多为现代建筑。","see":"萨那的老城区于1986年列入联合国教科文组织世界遗产名录，登录区包括11世纪前建造的103座清真寺、14座哈玛姆寺和6,000间会所。","scope":"reference","qid":"Q2471","articleTitle":"萨那","sourceRevision":94553270,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 萨那","https://zh.wikipedia.org/wiki/%E8%90%A8%E9%82%A3"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94553270"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q2471"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}],"cities":[{"id":"city-1159151259","name":"萨那","country":"YEM","lat":15.35668,"lon":44.20465,"kind":"city","region":"YE-SA","rank":2,"capital":1,"knowledge":{"theme":"萨那 · 地形、历史与地方特色","geo":"萨那位于海拔的高原上，距离亚丁320公里。\n萨那属于沙漠气候，但相对较潮湿，平均年降水量约200毫米。\n由于当地海拔较高，城市气温比阿拉伯半岛的其他地区相比要明显低，一年最高温度平均为23.42摄氏度，最底温度平均为10.93摄氏度。","culture":"前者面积较小，保留城市古老的文化遗产，保存老的商业生活方式，而新城则是由郊区城市化扩张而来，多为现代建筑。","see":"萨那的老城区于1986年列入联合国教科文组织世界遗产名录，登录区包括11世纪前建造的103座清真寺、14座哈玛姆寺和6,000间会所。","scope":"reference","qid":"Q2471","articleTitle":"萨那","sourceRevision":94553270,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 萨那","https://zh.wikipedia.org/wiki/%E8%90%A8%E9%82%A3"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94553270"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q2471"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159150595","name":"亚丁","country":"YEM","lat":12.77972,"lon":45.00949,"kind":"city","region":"YE-AD","rank":3,"capital":0,"knowledge":{"theme":"亚丁 · 地形、历史与地方特色","geo":"亚丁位于阿拉伯半岛南端、亚丁湾北岸，红海入口曼德海峡位于亚丁以西160公里。\n亚丁是典型的热带沙漠气候，全年炎热，降水稀少。","culture":"历史上曾被阿克苏姆、罗马帝国、波斯帝国等占领。\n在波斯帝国萨珊王朝统治时期，此地称为三兰（Samran）。","see":null,"scope":"reference","qid":"Q131694","articleTitle":"亞丁","sourceRevision":91188269,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 亚丁","https://zh.wikipedia.org/wiki/%E4%BA%9E%E4%B8%81"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91188269"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q131694"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159149317","name":"塔伊兹","country":"YEM","lat":13.6064,"lon":44.03747,"kind":"city","region":"YE-TA","rank":4,"capital":0,"knowledge":{"theme":"塔伊兹 · 地点概要","geo":"塔伊兹 是也门高原地区的一座城市，海拔高度为1,400米。","culture":null,"see":null,"scope":"reference","qid":"Q466216","articleTitle":"塔伊茲","sourceRevision":94770724,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 塔伊兹","https://zh.wikipedia.org/wiki/%E5%A1%94%E4%BC%8A%E8%8C%B2"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94770724"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q466216"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159147489","name":"萨达","country":"YEM","lat":16.93978,"lon":43.84977,"kind":"city","region":"YE-SD","rank":6,"capital":0,"knowledge":{"theme":"萨达 · 地形、历史与地方特色","geo":"萨达所在的也门西北部山区为地区，属于（汉志山脉南部）向南延伸至也门的余脉，邻近也门东北部高原地区，靠近阿拉伯沙漠地区的核心鲁卜哈利沙漠，总体属于热带沙漠气候（柯本气候分类法：），炎热干燥缺水，以畜牧业为主。\n这座清真寺是阿拉伯半岛上最古老的什叶派清真寺，同时也是也门第三古老的清真寺。\n古城内有14座建于10世纪至16世纪的清真寺，其中埋葬着第一位宰德派伊玛目哈迪及其11位后继者，它是阿拉伯半岛上最古老的什叶派清真寺及也门第三古老的清真寺，它在2015年5月遭到空袭，损坏严重。","culture":"萨达的中世纪古城由传统方式建造，而在古城周边建有繁华的新镇，新镇里有典型的街道、类似车库形状的和典型的阿拉伯风格商店。\n早在也门历史上最早的国家统治时期，今天萨达所在的区域就被纳入了也门的国家版图之中。","see":"2002年7月8日，由下属的古城保护总组织主席办公室提交，联合国教育、科学及文化组织世界遗产中心将萨达古城列入世界文化遗产预备名单。\n萨达古城曾经长期繁荣，城中的建筑不间断地沿用中世纪的建筑风格，拥有非常典型的、代表整个区域的土地结构。\n萨达古城城墙周长约3000米、厚4米，城墙上有52座瞭望塔和16座城门，其中最著名的有“也门门”和“奈季兰门”。","scope":"reference","qid":"Q991395","articleTitle":"萨达 (也门)","sourceRevision":94208089,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 萨达 (也门)","https://zh.wikipedia.org/wiki/%E8%90%A8%E8%BE%BE%20%28%E4%B9%9F%E9%97%A8%29"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94208089"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q991395"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159147491","name":"荷台达","country":"YEM","lat":14.79989,"lon":42.95103,"kind":"city","region":"YE-HU","rank":6,"capital":0,"knowledge":{"theme":"荷台达 · 地点概要","geo":"荷台达位于红海旁，是一个港口，出口咖啡、棉花、海枣等。","culture":null,"see":null,"scope":"reference","qid":"Q270041","articleTitle":"荷台達","sourceRevision":94301716,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 荷台达","https://zh.wikipedia.org/wiki/%E8%8D%B7%E5%8F%B0%E9%81%94"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94301716"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q270041"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159147529","name":"赛胡特加米拉","country":"YEM","lat":15.2105,"lon":51.24544,"kind":"city","region":"YE-MR","rank":6,"capital":0},{"id":"city-1159147531","name":"穆卡拉","country":"YEM","lat":14.54116,"lon":49.12593,"kind":"city","region":"YE-HD","rank":6,"capital":0,"knowledge":{"theme":"穆卡拉 · 地点概要","geo":"穆卡拉 是也门的一个主要亚丁湾沿岸的海港城市，距离阿拉伯海比较近，位于亚丁以东480公里。","culture":null,"see":null,"scope":"reference","qid":"Q310772","articleTitle":"穆卡拉","sourceRevision":94658167,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 穆卡拉","https://zh.wikipedia.org/wiki/%E7%A9%86%E5%8D%A1%E6%8B%89"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94658167"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q310772"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159133939","name":"扎比德","country":"YEM","lat":14.19509,"lon":43.31554,"kind":"city","region":"YE-HU","rank":7,"capital":0,"knowledge":{"theme":"扎比德 · 地形、历史与地方特色","geo":"宰比德，又译作札比德、扎比德，是一座位于也门西部海岸平原上的城镇。","culture":"根据传统的说法，这是伊斯兰历史上第五座清真寺。\n13世纪至15世纪，拉苏勒王朝也将首都置于宰比德，并在当时成为阿拉伯世界与伊斯兰文化的一处中心，很大程度上归功于宰比德大学在学术上享有盛名。","see":"艾什尔里清真寺成为该区域内最显著的地标式建筑，宰比德大学遗址同样也是古城中可探访的历史遗迹。\n1993年，宰比德历史古城被联合国教科文组织列入世界遗产名录。\n如若该区域内的保护情况无法得到有效的改善，有可能会失去其