],[160.8679,-9.1521],[160.6931,-8.7512],[160.6545,-8.6041],[160.72,-8.5534],[160.5935,-8.3849],[160.5811,-8.3405],[160.6013,-8.3255],[160.7028,-8.3645],[160.7302,-8.3491],[160.7057,-8.3062],[160.759,-8.3167],[160.9968,-8.6038],[161.0027,-8.6624],[160.9424,-8.6922],[160.9466,-8.8137],[160.9759,-8.8503],[161.023,-8.8408],[161.0591,-8.8989],[161.1511,-8.9496],[161.169,-8.9745],[161.1428,-8.9887],[161.2287,-9.1037],[161.2025,-9.1384],[161.2849,-9.1862],[161.2443,-9.2053],[161.2788,-9.2892],[161.2354,-9.2812],[161.3811,-9.509],[161.3926,-9.6091],[161.3607,-9.6176]]],[[[160.6358,-7.891],[160.648,-7.9269],[160.6076,-7.8888],[160.6358,-7.891]]]]},"knowledge":{"theme":"马莱塔省 · 地形、历史与地方特色","geo":"1893年，的舰长吉柏森（Captain Gibson R.N.）宣布南索罗门群岛为英国的保护国，于焉成立，马莱塔正式纳入大英帝国行政体系中。\n从文化看来，这两个岛屿的文化属于，但因为其分布位置位于传统玻里尼西亚的分布领域之外，被归类为。\n马莱塔省政府与所罗门群岛中央政府长期对立。","culture":"该省迄今仍保留许多独特的传统文化，其聘礼制度与周边岛屿相比有其独特之处，且至今仍有贝币的制作及流通。\n至今兰加兰加潟湖的居民仍有持续制造贝珠钱的传统，但大多数为上一辈传承下来的。","see":null,"scope":"reference","qid":"Q1190896","articleTitle":"馬萊塔省","sourceRevision":89782184,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 马莱塔省","https://zh.wikipedia.org/wiki/%E9%A6%AC%E8%90%8A%E5%A1%94%E7%9C%81"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=89782184"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1190896"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"SB-CT","name":"霍尼亚拉","english":"Capital Territory (Honiara)","country":"SLB","lat":-9.44658,"lon":160.019,"kind":"region","bbox":[159.9397,-9.4674,160.042,-9.4311],"geometry":{"type":"Polygon","coordinates":[[[159.9397,-9.4329],[160.042,-9.4311],[160.022,-9.4674],[159.9397,-9.4329]]]},"knowledge":{"theme":"霍尼亚拉 · 地形、历史与地方特色","geo":"每年的平均降水量约为2,000毫米（79 英寸），因此低于整个所罗门群岛的平均降水量（3,000 毫米（120 英寸）），城市时常受到季风影响。\n该市由霍尼亚拉国际机场和克鲁兹角海港提供服务，位于库库姆高速公路沿线。\n霍尼亚拉位于太平洋上的瓜达尔卡纳尔岛北岸，城市以东的机场区，是第二次世界大战瓜达尔卡纳尔岛战役中美日交战的地点，二战结束后，因所罗门群岛原首都图拉吉遭受严重破坏，1952年，英国选择拥有深水港的战略要地霍尼亚拉建设新首都。","culture":null,"see":"霍尼亚拉有一座港口，作为通向其他省（岛屿）的主要交通枢纽；市内国家艺术馆公园是人们休闲的重要场所，此外主要建筑有重新建设的政府大厦和国家博物馆，最吸引旅游者的还有游艇俱乐部和著名的所罗门奇达诺·曼达纳旅店。","scope":"reference","qid":"Q40921","articleTitle":"霍尼亚拉","sourceRevision":92783758,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 霍尼亚拉","https://zh.wikipedia.org/wiki/%E9%9C%8D%E5%B0%BC%E4%BA%9A%E6%8B%89"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=92783758"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q40921"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"SB-GU","name":"瓜达尔卡纳尔省","english":"Guadalcanal","country":"SLB","lat":-9.61695,"lon":160.209,"kind":"region","bbox":[159.5921,-9.9371,160.8247,-9.2477],"geometry":{"type":"Polygon","coordinates":[[[160.028,-9.4221],[160.3664,-9.4128],[160.5037,-9.5363],[160.6284,-9.5823],[160.673,-9.698],[160.7854,-9.7275],[160.8247,-9.8673],[160.6448,-9.9371],[160.4329,-9.8891],[160.3203,-9.8151],[160.0313,-9.8238],[159.8872,-9.7828],[159.8356,-9.7939],[159.7234,-9.707],[159.6018,-9.5219],[159.6272,-9.488],[159.5921,-9.3615],[159.616,-9.2953],[159.709,-9.2477],[159.8733,-9.3595],[159.9538,-9.4503],[160.022,-9.4674],[160.028,-9.4221]]]},"knowledge":{"theme":"瓜达尔卡纳尔省 · 地点概要","geo":"瓜达尔卡纳尔省（Guadalcanal Province）是所罗门群岛中部的一个省，幅盖了瓜达尔卡纳尔岛大部分地区。","culture":null,"see":null,"scope":"reference","qid":"Q760888","articleTitle":"瓜達爾卡納爾省","sourceRevision":83255367,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 瓜达尔卡纳尔省","https://zh.wikipedia.org/wiki/%E7%93%9C%E9%81%94%E7%88%BE%E5