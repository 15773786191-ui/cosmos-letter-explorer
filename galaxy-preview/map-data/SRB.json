,44.4189],"geometry":{"type":"Polygon","coordinates":[[[20.7253,43.7751],[20.5262,43.9469],[20.6369,44.0202],[20.4619,44.1558],[20.4154,44.2841],[20.3891,44.2943],[20.4333,44.3561],[20.3967,44.3893],[20.4422,44.4189],[20.5379,44.3857],[20.5385,44.3558],[20.6113,44.373],[20.6498,44.3218],[20.6905,44.3347],[20.8195,44.2903],[20.8163,44.2576],[20.9739,44.259],[20.9963,44.22],[21.1392,44.1833],[21.1357,44.0891],[21.0542,44.0474],[21.103,44.0211],[21.041,43.9756],[21.0623,43.9428],[21.0,43.8939],[21.0147,43.8547],[20.9355,43.8046],[20.8607,43.84],[20.789,43.8309],[20.7592,43.8199],[20.7702,43.7893],[20.7253,43.7751]]]}},{"id":"RS-17","name":"莫拉瓦州","english":"Moravicki","country":"SRB","lat":43.7127,"lon":20.2653,"kind":"region","bbox":[19.8937,43.2607,20.6369,44.2418],"geometry":{"type":"Polygon","coordinates":[[[20.6208,43.8592],[20.5591,43.8198],[20.5259,43.7452],[20.4435,43.7224],[20.4601,43.6468],[20.3584,43.6314],[20.3673,43.5781],[20.3059,43.5348],[20.4019,43.454],[20.4214,43.3501],[20.3283,43.2607],[20.2447,43.3175],[20.1004,43.309],[20.0018,43.4816],[19.8937,43.5348],[19.9088,43.5758],[19.9736,43.5585],[20.0825,43.6071],[20.0827,43.6448],[20.1559,43.6319],[20.1749,43.6561],[20.1654,43.7193],[20.1241,43.74],[20.1301,43.7916],[20.0877,43.8421],[20.1556,43.877],[20.0891,43.9117],[20.103,43.9375],[20.0558,43.9812],[20.062,44.0853],[20.1246,44.0737],[20.1765,44.1119],[20.2851,44.1207],[20.4231,44.2418],[20.4619,44.1558],[20.6369,44.0202],[20.5262,43.9469],[20.6208,43.8592]]]},"knowledge":{"theme":"莫拉瓦州 · 地点概要","geo":"摩拉维察区是塞尔维亚中西部的行政区，行政中心为查查克。","culture":null,"see":null,"scope":"reference","qid":"Q915380","articleTitle":"摩拉维察区","sourceRevision":94814078,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 摩拉维察区","https://zh.wikipedia.org/wiki/%E6%91%A9%E6%8B%89%E7%BB%B4%E5%AF%9F%E5%8C%BA"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94814078"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q915380"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"RS-09","name":"科卢巴拉州","english":"Kolubarski","country":"SRB","lat":44.3209,"lon":19.9249,"kind":"region","bbox":[19.4257,44.0529,20.4238,44.5648],"geometry":{"type":"Polygon","coordinates":[[[19.7256,44.107],[19.4257,44.2541],[19.492,44.3223],[19.449,44.3605],[19.4938,44.3896],[19.4866,44.4355],[19.561,44.4457],[19.8348,44.3887],[19.8272,44.4296],[19.8622,44.4369],[19.8702,44.4848],[19.8499,44.524],[19.8977,44.5591],[19.9711,44.5648],[19.99,44.5223],[20.0951,44.526],[20.1278,44.4952],[20.1847,44.5418],[20.2264,44.4494],[20.1923,44.3081],[20.2692,44.242],[20.3891,44.2943],[20.4238,44.2524],[20.3722,44.1759],[20.2868,44.1214],[20.1765,44.1119],[20.1246,44.0737],[20.0095,44.1042],[19.954,44.0784],[19.8647,44.1301],[19.8289,44.105],[19.7745,44.116],[19.8111,44.0684],[19.785,44.0529],[19.7256,44.107]]]},"knowledge":{"theme":"科卢巴拉州 · 地点概要","geo":"科卢巴拉区是塞尔维亚西部的行政区，行政中心为瓦列沃。","culture":null,"see":null,"scope":"reference","qid":"Q1048139","articleTitle":"科盧巴拉區","sourceRevision":88601266,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 科卢巴拉区","https://zh.wikipedia.org/wiki/%E7%A7%91%E7%9B%A7%E5%B7%B4%E6%8B%89%E5%8D%80"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=88601266"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q1048139"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}}],"cities":[{"id":"city-1159151079","name":"贝尔格莱德","country":"SRB","lat":44.82059,"lon":20.46605,"kind":"city","region":"RS-00","rank":3,"capital":1,"knowledge":{"theme":"贝尔格莱德 · 地形、历史与地方特色","geo":"贝尔格莱德市位于塞尔维亚北部萨瓦河和多瑙河汇合处，此处也是潘诺尼亚平原和巴尔干半岛的相遇处。\n约7,000年前，温查文明出现在贝尔格莱德附近，一度在巴尔干半岛占据统治地位。\n贝尔格莱德成了当时巴尔干半岛人民躲避奥斯曼帝国控制的天堂。","culture":"贝尔格莱德每年举办多个文化节日，包括贝尔格莱德电影节、贝尔格莱德戏剧节、贝尔格莱德音乐节、贝尔格莱德书展和贝尔格莱德啤酒节。\n贝尔格莱德最著名的博物馆是建于1844年的塞尔维亚国家博物馆，收藏有包括许多外国杰作在内的超400,000件展品。","see":"建于1901年的贝尔格莱德民族博物馆收藏有150,000多件反映巴尔干半岛特别是前南斯拉夫国家乡村文化的展品。\n建于1952年的尼古拉·特斯拉博物馆收藏的是著名科学家尼古拉·特斯拉的私人物品，拥有约160,000件原始文献和约5,700件其它物品。\n城市古老的城墙、城堡、港口和教堂得到了加固，从而帮助王国在长达70年的时间内抵御住了奥斯曼帝国的进攻。","scope":"reference","qid":"Q3711","articleTitle":"贝尔格莱德","sourceRevision":94684094,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 贝尔格莱德","https://zh.wikipedia.org/wiki/%E8%B4%9D%E5%B0%94%E6%A0%BC%E8%8E%B1%E5%BE%B7"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94684094"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q3711"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159144041","name":"查查克","country":"SRB","lat":43.88974,"lon":20.33012,"kind":"city","region":"RS-17","rank":7,"capital":0,"knowledge":{"theme":"查查克 · 地形、历史与地方特色","geo":"查查克是塞尔维亚摩拉维察区的城市，位于首都贝尔格莱德市以南140公里。\n查查克市海拔204米，出在西摩拉瓦河的上游。\nČačanska Kotlina 海拔200-300米。","culture":"最古老的塞尔维亚文化的考古发现被追溯到公元10世纪。\n查查克附近最古老的考古发现可以追溯到石器时代（公元前8000－3200年）。","see":null,"scope":"reference","qid":"Q208038","articleTitle":"查查克","sourceRevision":90434957,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 查查克","https://zh.wikipedia.org/wiki/%E6%9F%A5%E6%9F%A5%E5%85%8B"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=90434957"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q208038"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159144045","name":"尼什","country":"SRB","lat":43.33042,"lon":21.9,"kind":"city","region":"RS-20","rank":7,"capital":0,"knowledge":{"theme":"尼什 · 地形、历史与地方特色","geo":"尼什位于摩拉瓦河流域北部和瓦尔达尔河流域南部，地理位置重要，位于连接希腊和中欧主要交通走廊的途中。\n尼什位于尼沙瓦河流域的东侧，靠近尼沙瓦河和南摩拉瓦河的交汇处。\n尼什是欧洲和巴尔干半岛最古老的城市之一，在古代就被认为是连接东西方世界的重要通道。","culture":"尼什要塞修建于奥斯曼时期，至今日依然保存良好，是巴尔干地区保存状态最好的要塞之一。\n尼什最初的旅馆「Europe」建于1879年。","see":"后来这座京观成为尼什的地标以及塞尔维亚独立的象征。\n1913年，开设了市博物馆，收藏考古学及民俗学相关藏品和艺术作品。","scope":"reference","qid":"Q129259","articleTitle":"尼什","sourceRevision":88998207,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 尼什","https://zh.wikipedia.org/wiki/%E5%B0%BC%E4%BB%80"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=88998207"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q129259"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159144059","name":"诺维萨德","country":"SRB","lat":45.25038,"lon":19.84994,"kind":"city","region":"RS-06","rank":7,"capital":0,"knowledge":{"theme":"诺维萨德 · 地形、历史与地方特色","geo":"有21条城区线路和29条市郊线路，主要巴士站位于解放大道北端，毗邻诺维萨德火车站。\n其位于匈塞铁路之上，该铁路连接了欧洲的主要城市。\n有三座跨多瑙河大桥位于诺维萨德：连接斯雷姆斯卡卡梅尼察与市区，与另外一座连接彼得罗瓦拉丁与市中心，以及铁路与重卡运输。","culture":"城市的主要景点是彼得罗瓦拉丁要塞，建于1692至1780年之间。\n这座城堡在当时是抗击土耳其军队的主要集结地与防御要塞。","see":null,"scope":"reference","qid":"Q55630","articleTitle":"诺维萨德","sourceRevision":94221669,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 诺维萨德","https://zh.wikipedia.org/wiki/%E8%AF%BA%E7%BB%B4%E8%90%A8%E5%BE%B7"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=94221669"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q55630"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159130873","name":"苏博蒂察","country":"SRB","lat":46.07002,"lon":19.68003,"kind":"city","region":"RS-01","rank":8,"capital":0,"knowledge":{"theme":"苏博蒂察 · 地点概要","geo":"苏博蒂察（，；，，索包德考；，玛丽亚泰雷西奥佩尔）是塞尔维亚伏伊伏丁那自治省北部北巴奇卡区的城市，并为该区的行政中心。","culture":null,"see":null,"scope":"reference","qid":"Q170287","articleTitle":"苏博蒂察","sourceRevision":91665517,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 苏博蒂察","https://zh.wikipedia.org/wiki/%E8%8B%8F%E5%8D%9A%E8%92%82%E5%AF%9F"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=91665517"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q170287"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159131621","name":"克拉古耶瓦茨","country":"SRB","lat":44.01996,"lon":20.92,"kind":"city","region":"RS-12","rank":8,"capital":0,"knowledge":{"theme":"克拉古耶瓦茨 · 地形、历史与地方特色","geo":"克拉古耶瓦茨是塞尔维亚舒马迪亚区的城市，为该区的行政中心及最大城市，也是全国第四大城市（继贝尔格莱德、新沙德和尼什之后）。\n1818年至1839年间，克拉古耶瓦茨是塞尔维亚公国的首都。","culture":"克拉古耶瓦茨在1476年成立，塞尔维亚独立后的第一所大学在1838年于该市建立，克拉古耶瓦茨大学（1976年成立）也建于该市。","see":null,"scope":"reference","qid":"Q167394","articleTitle":"克拉古耶瓦茨","sourceRevision":90435024,"method":"Full-article section excerpts; traditional Chinese converted to simplified; tables, citations, population and current-office statistics omitted.","attribution":"中文维基百科资料摘编、删节与繁简转换 · CC BY-SA 4.0（作者见原文历史）","sources":[["地点资料 · 克拉古耶瓦茨","https://zh.wikipedia.org/wiki/%E5%85%8B%E6%8B%89%E5%8F%A4%E8%80%B6%E7%93%A6%E8%8C%A8"],["原文版本与作者","https://zh.wikipedia.org/w/index.php?oldid=90435024"],["地点身份 · Wikidata","https://www.wikidata.org/wiki/Q167394"],["资料许可 · CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}},{"id":"city-1159131625","name":"兹雷尼亚宁","country":"SRB","lat":45.37864,"lon":20.39947,"kind":"city","region":"RS-02","rank":8,"capital":0,"knowledge":{"theme":"兹雷尼亚宁 · 地点概要","geo":"兹雷尼亚宁是塞尔维亚伏伊伏丁那自治省中巴纳特区的城